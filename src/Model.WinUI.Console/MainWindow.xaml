<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModelWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModelWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:ModelConsole.Controls"
    mc:Ignorable="d">

   <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Menu bar (backlog 004): File → Open Model… loads a model from a
           JSON file and renders it in both renderers. File → Open Sample
           (backlog 005) lists the shipped sample models; the submenu items
           are built in code-behind from SampleModels.All. The Border owns the
           color full-bleed (so the WinUI MenuBar's own chrome never shows a
           white margin around it) and draws the soft separator line beneath
           that visually separates the menu from the renderer bar. -->
      <Border Grid.Row="0"
              Background="{ThemeResource MenuBarBackgroundBrush}"
              BorderBrush="{ThemeResource MenuBarBorderBrush}"
              BorderThickness="0,0,0,1">
         <MenuBar Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  Foreground="{ThemeResource MenuBarForegroundBrush}">
            <MenuBarItem Title="File">
               <MenuFlyoutItem Text="Open Model…" Click="OpenModel_Click" />
               <MenuFlyoutSeparator />
               <MenuFlyoutSubItem x:Name="OpenSampleMenu" Text="Open Sample" />
            </MenuBarItem>
         </MenuBar>
      </Border>

      <!-- Slim renderer bar (backlog 003): switch the main view between the
           XAML ERD (ModelEditorControl) and the Skia ERD (SkiaPanelControl). Only one
           control is visible at a time. The "Base:" drop-down (backlog 041)
           drives the drawing-surface background color on both renderers. -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                  Margin="10,8"
                  Background="{ThemeResource RendererBarBackgroundBrush}">
         <TextBlock Text="Renderer:" VerticalAlignment="Center" />
         <ToggleButton x:Name="XamlToggle" Content="XAML model"
                       IsChecked="True" Click="RendererToggle_Click" />
         <ToggleButton x:Name="SkiaToggle" Content="Skia render"
                       Click="RendererToggle_Click" />
         <TextBlock Text="Base:" VerticalAlignment="Center" Margin="12,0,0,0" />
         <ComboBox x:Name="BackgroundComboBox"
                   MinWidth="110"
                   VerticalAlignment="Center"
                   ToolTipService.ToolTip="Drawing-surface (base) background color"
                   SelectionChanged="BackgroundCombo_SelectionChanged">
            <ComboBoxItem Content="White" Tag="#FFFFFF" IsSelected="True" />
            <ComboBoxItem Content="Ivory" Tag="#FFFFF0" />
            <ComboBoxItem Content="Mint" Tag="#F0FFF0" />
            <ComboBoxItem Content="Light Gray" Tag="#E8EDF2" />
            <ComboBoxItem Content="Custom…" Tag="custom" />
         </ComboBox>
      </StackPanel>

      <Grid Grid.Row="2">
         <ct:ModelEditorControl x:Name="XamlEditor" />
         <ct:SkiaPanelControl x:Name="SkiaEditor" Visibility="Collapsed" />
      </Grid>

      <!-- Slim window footer (ad-hoc): a thin chrome strip whose top line
           separates the controls from the bottom of the window. Holds a
           muted status line for now. -->
      <Border Grid.Row="3"
              Height="26"
              Background="{ThemeResource WindowFooterBackgroundBrush}"
              BorderBrush="{ThemeResource MenuBarBorderBrush}"
              BorderThickness="0,1,0,0">
         <TextBlock Text="Ready"
                    FontSize="11"
                    Foreground="{ThemeResource MenuBarForegroundBrush}"
                    Opacity="0.6"
                    Margin="10,0"
                    VerticalAlignment="Center" />
      </Border>
   </Grid>
</Window>
