<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModelWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModelWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:ModelConsole.Controls"
    mc:Ignorable="d">

   <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Menu bar (backlog 004): File → Open Model… loads a model from a
           JSON file and renders it in both renderers. File → Open Sample
           (backlog 005) lists the shipped sample models; the submenu items
           are built in code-behind from SampleModels.All. The Border owns the
           color full-bleed (so the WinUI MenuBar's own chrome never shows a
           white margin around it) and draws the soft separator line beneath
           that visually separates the menu from the renderer bar. -->
      <Border Grid.Row="0"
              Background="{ThemeResource MenuBarBackgroundBrush}"
              BorderBrush="{ThemeResource MenuBarBorderBrush}"
              BorderThickness="0,0,0,1">
         <MenuBar Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  Foreground="{ThemeResource MenuBarForegroundBrush}">
            <MenuBarItem Title="File">
               <MenuFlyoutItem Text="Open Model…" Click="OpenModel_Click" />
               <MenuFlyoutSeparator />
               <MenuFlyoutSubItem x:Name="OpenSampleMenu" Text="Open Sample" />
               <MenuFlyoutSeparator />
               <MenuFlyoutItem Text="Export PlantUML…" Click="ExportPlantUml_Click" />
               <MenuFlyoutSeparator />
               <!-- Backlog 054: save the live editable model as JSON (the same
                    shape File → Open Model… reads), so a saved model can be
                    reopened and edited. -->
               <MenuFlyoutItem Text="Save As Model JSON…" Click="SaveModelJson_Click" />
               <MenuFlyoutSeparator />
               <!-- Backlog 054: full-diagram visual exports through the shared
                    Skia composition path (ErdExporter), so PNG and PDF match. -->
               <MenuFlyoutItem Text="Export PNG…" Click="ExportPng_Click" />
               <MenuFlyoutSeparator />
               <!-- Backlog 042: the modeless entity-details window, opened in
                    model mode (provenance + model metadata readout). The same
                    window double-clicking a table opens in entity mode. -->
               <MenuFlyoutItem Text="Model info" Click="ModelInfo_Click" />
            </MenuBarItem>
         </MenuBar>
      </Border>

      <!-- Slim renderer bar (backlog 003): switch the main view between the
           XAML ERD (ModelEditorControl) and the Skia ERD (SkiaPanelControl). Only one
           control is visible at a time. The "Base:" drop-down (backlog 041)
           drives the drawing-surface background color on both renderers. -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                  Margin="10,8"
                  Background="{ThemeResource RendererBarBackgroundBrush}">
         <TextBlock Text="Renderer:" VerticalAlignment="Center" />
         <ToggleButton x:Name="XamlToggle" Content="XAML model"
                       IsChecked="True" Click="RendererToggle_Click" />
         <ToggleButton x:Name="SkiaToggle" Content="Skia render"
                       Click="RendererToggle_Click" />
         <TextBlock Text="Notation:" VerticalAlignment="Center" Margin="12,0,0,0" />
         <ToggleButton x:Name="ErdNotationToggle" Content="ERD"
                       IsChecked="True" Click="NotationToggle_Click" />
         <ToggleButton x:Name="CrowFootNotationToggle" Content="Crow's Foot"
                       Click="NotationToggle_Click" />
         <ToggleButton x:Name="UmlNotationToggle" Content="UML"
                       Click="NotationToggle_Click" />
         <TextBlock Text="Base:" VerticalAlignment="Center" Margin="12,0,0,0" />
         <ComboBox x:Name="BackgroundComboBox"
                   MinWidth="110"
                   VerticalAlignment="Center"
                   ToolTipService.ToolTip="Drawing-surface (base) background color"
                   SelectionChanged="BackgroundCombo_SelectionChanged">
            <ComboBoxItem Content="White" Tag="#FFFFFF" IsSelected="True" />
            <ComboBoxItem Content="Ivory" Tag="#FFFFF0" />
            <ComboBoxItem Content="Mint" Tag="#F0FFF0" />
            <ComboBoxItem Content="Light Gray" Tag="#E8EDF2" />
            <ComboBoxItem Content="Custom…" Tag="custom" />
         </ComboBox>
         <TextBlock Text="Focus:" VerticalAlignment="Center" Margin="12,0,0,0" />
         <Button x:Name="ConnectorColorButton"
                 Padding="4"
                 VerticalAlignment="Center"
                 Click="ConnectorColorButton_Click"
                 ToolTipService.ToolTip="Selected connector color">
            <Border x:Name="ConnectorColorSwatch"
                    Width="18"
                    Height="18"
                    Background="#6A5ACD"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" />
         </Button>
         <Slider x:Name="ConnectorWidthSlider"
                 Minimum="1"
                 Maximum="8"
                 Value="3.5"
                 StepFrequency="0.5"
                 SnapsTo="StepValues"
                 Width="90"
                 VerticalAlignment="Center"
                 ToolTipService.ToolTip="Selected connector width"
                 ValueChanged="ConnectorWidthSlider_ValueChanged" />
         <TextBlock x:Name="ConnectorWidthText"
                    Text="3.5"
                    MinWidth="24"
                    VerticalAlignment="Center" />
      </StackPanel>

      <Grid Grid.Row="2">
         <ct:ModelEditorControl x:Name="XamlEditor" />
         <ct:SkiaPanelControl x:Name="SkiaEditor" Visibility="Collapsed" />
      </Grid>

      <!-- Slim window footer (ad-hoc): a thin chrome strip whose top line
           separates the controls from the bottom of the window. Holds a
           muted status line for now. -->
      <Border Grid.Row="3"
              Height="26"
              Background="{ThemeResource WindowFooterBackgroundBrush}"
              BorderBrush="{ThemeResource MenuBarBorderBrush}"
              BorderThickness="0,1,0,0">
         <TextBlock Text="Ready"
                    FontSize="11"
                    Foreground="{ThemeResource MenuBarForegroundBrush}"
                    Opacity="0.6"
                    Margin="10,0"
                    VerticalAlignment="Center" />
      </Border>
   </Grid>
</Window>
