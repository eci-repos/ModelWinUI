<UserControl
   x:Class="ModelConsole.Controls.SkiaPanelControl"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:local="using:ModelConsole.Controls"
   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   xmlns:sk="using:SkiaSharp.Views.Windows"
   mc:Ignorable="d"
   d:DesignHeight="300"
   d:DesignWidth="400">

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Zoom toolbar (backlog 015): fit-to-window button + scale slider +
           % readout, mirroring the XAML path's toolbar. Fit is the default
           and is recomputed on every paint, so resizing the window re-fits. -->
      <Border Grid.Row="0"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              Padding="8,4">
         <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="FitButton" Click="FitButton_Click"
                    ToolTipService.ToolTip="Fit to window"
                    Padding="6">
               <FontIcon Glyph="&#xE81C;" FontSize="14" />
            </Button>
            <Slider x:Name="ZoomSlider" Minimum="10" Maximum="400"
                    StepFrequency="5" SnapsTo="StepValues" Width="160"
                    VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged" />
            <TextBlock x:Name="ZoomPercent" Text="100%" VerticalAlignment="Center" />
         </StackPanel>
      </Border>

      <Grid Grid.Row="1">
         <sk:SKXamlCanvas x:Name="SkiaCanvas" PaintSurface="SkiaCanvas_PaintSurface" />
         <!-- Shown while the diagram is being composed off the UI thread, so
              the first paint shows progress instead of a blank canvas. -->
         <TextBlock x:Name="ComposingText" Text="Composing…"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="16" Visibility="Collapsed" />
      </Grid>
   </Grid>
</UserControl>
