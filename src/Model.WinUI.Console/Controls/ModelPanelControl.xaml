<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModelConsole.Controls.ModelPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModelConsole.Controls"
    xmlns:gl="using:ModelConsole.Graphics.GLibrary"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Zoom toolbar: fit-to-window button + scale slider + % entry box.
           All three drive the ScrollViewer's native zoom (ChangeView). -->
      <Border Grid.Row="0"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              Padding="8,4">
         <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="FitButton" Click="FitButton_Click"
                    ToolTipService.ToolTip="Fit to window (Ctrl+1)"
                    Padding="6">
               <StackPanel Orientation="Horizontal" Spacing="4">
                  <FontIcon Glyph="&#xE81C;" FontSize="14" />
                  <TextBlock Text="Fit" VerticalAlignment="Center" />
               </StackPanel>
            </Button>
            <Slider x:Name="ZoomSlider" Minimum="10" Maximum="400"
                    StepFrequency="5" SnapsTo="StepValues" Width="160"
                    VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged" />
            <TextBox x:Name="ZoomTextBox" Width="56" Text="100"
                     VerticalAlignment="Center"
                     KeyDown="ZoomTextBox_KeyDown"
                     LostFocus="ZoomTextBox_LostFocus" />
            <TextBlock Text="%" VerticalAlignment="Center" />
         </StackPanel>
      </Border>

      <!-- Scroll bars are Hidden (not Auto): the user finds them confusing.
           Panning and zoom still work programmatically via ChangeView, so
           hiding the bars only removes the visual clutter. ScrollMode is
           Disabled so the mouse wheel can never scroll the paper (the WinUI 3
           ScrollViewer scrolls on wheel even when the canvas marks the event
           handled); all zoom/pan goes through ChangeView, which is unaffected
           by ScrollMode. -->
      <!-- The drawing (ScrollViewer + canvas) and the hover tooltip share row
           1. The tooltip overlay is a hit-test-transparent sibling of the
           ScrollViewer, so it is positioned in viewport px (the overlay fills
           the same cell as the ScrollViewer's viewport) and never intercepts
           pointer events (backlog 027). -->
      <Grid Grid.Row="1">
         <ScrollViewer x:Name="ModelScrollViewer"
                       HorizontalScrollBarVisibility="Hidden"
                       VerticalScrollBarVisibility="Hidden"
                       HorizontalScrollMode="Disabled"
                       VerticalScrollMode="Disabled"
                       ZoomMode="Enabled"
                       MinZoomFactor="0.1"
                       MaxZoomFactor="4.0"
                       ViewChanged="ModelScrollViewer_ViewChanged">
            <!-- Background="Transparent" is required: a Panel with a null
                 Background is not hit-testable in its empty areas, so presses
                 on empty canvas space would never reach the pan gesture
                 (backlog 011). PointerWheelChanged is handled here (not on the
                 ScrollViewer) so the wheel zooms instead of scrolling: the
                 pointer is marked handled and never bubbles to the
                 ScrollViewer's scroll handler. -->
            <gl:GlCanvas x:Name="ModelCanvas" Background="Transparent"
                         PointerWheelChanged="ModelCanvas_PointerWheelChanged" />
         </ScrollViewer>

         <!-- Hover readout (backlog 027): delay-triggered, pointer-following,
              strictly read-only. The overlay is hit-test transparent so all
              pointer events reach the canvas below unchanged. -->
         <Canvas x:Name="HoverOverlay" IsHitTestVisible="false">
            <Border x:Name="HoverTooltip" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,6"
                    MaxWidth="320">
               <StackPanel x:Name="HoverTooltipContent" Spacing="2" />
            </Border>
         </Canvas>
      </Grid>
   </Grid>
</UserControl>
