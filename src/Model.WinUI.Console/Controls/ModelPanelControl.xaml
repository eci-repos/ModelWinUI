<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModelConsole.Controls.ModelPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModelConsole.Controls"
    xmlns:gl="using:ModelConsole.Graphics.GLibrary"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Zoom toolbar: fit-to-window button + scale slider + % entry box.
           All three drive the ScrollViewer's native zoom (ChangeView). -->
      <Border Grid.Row="0"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              Padding="8,4">
         <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="FitButton" Click="FitButton_Click"
                    ToolTipService.ToolTip="Fit to window (Ctrl+1)"
                    Padding="6">
               <FontIcon Glyph="&#xE81C;" FontSize="14" />
            </Button>
            <Slider x:Name="ZoomSlider" Minimum="10" Maximum="400"
                    StepFrequency="5" SnapsTo="StepValues" Width="160"
                    VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged" />
            <TextBox x:Name="ZoomTextBox" Width="56" Text="100"
                     VerticalAlignment="Center"
                     KeyDown="ZoomTextBox_KeyDown"
                     LostFocus="ZoomTextBox_LostFocus" />
            <TextBlock Text="%" VerticalAlignment="Center" />
         </StackPanel>
      </Border>

      <ScrollViewer x:Name="ModelScrollViewer" Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    ZoomMode="Enabled"
                    MinZoomFactor="0.1"
                    MaxZoomFactor="4.0"
                    ViewChanged="ModelScrollViewer_ViewChanged">
         <!-- Background="Transparent" is required: a Panel with a null
              Background is not hit-testable in its empty areas, so presses
              on empty canvas space would never reach the pan gesture
              (backlog 011). -->
         <gl:GlCanvas x:Name="ModelCanvas" Background="Transparent" />
      </ScrollViewer>
   </Grid>
</UserControl>
