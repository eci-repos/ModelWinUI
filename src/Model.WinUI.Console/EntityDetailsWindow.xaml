<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModelWinUI.EntityDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModelWinUI"
    xmlns:ct="using:ModelConsole.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

   <!-- Backlog 042: the modeless entity-details window. Double-clicking a
        table or FK connector opens it; the reusable EntityInspectorControl
        fills the body, its header carries the Edit/Done toggle, and the
        system title bar carries the window title. The host (MainWindow) sets
        the title and drives the content via ShowEntity / ShowModelInfo. -->
   <Grid Background="{ThemeResource WindowBackgroundBrush}">
      <ct:EntityInspectorControl x:Name="Inspector" />
   </Grid>
</Window>
