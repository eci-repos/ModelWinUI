<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ModelConsole</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWinUI>true</UseWinUI>
    <Version>0.1.0</Version>
    <Description>Reusable WinUI 3 XAML drawing stack — the Gl* shape primitives, the ERD Table renderer, and the XAML factory contracts.</Description>
    <Authors>Eduardo Sobrino</Authors>
    <PackageId>Model.Console.Graphics.WinUI</PackageId>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Model.Diagnostics\Model.Diagnostics.csproj" />
    <ProjectReference Include="..\Model.Geometry\Model.Geometry.csproj" />
    <ProjectReference Include="..\Model.Data\Model.Data.csproj" />
    <ProjectReference Include="..\Model.Graph\Model.Graph.csproj" />
  </ItemGroup>

</Project>
