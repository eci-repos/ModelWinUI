<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModelConsole.Controls.ModelEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModelConsole.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left panel: model explorer (backlog 004). Collapsible so the
           drawing reflows into the freed space, mirroring the right panel. -->
      <Grid x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" MinWidth="220">
         <local:ModelExplorerControl x:Name="ExplorerPanel" Margin="0" />
      </Grid>

      <!-- Left toggle strip: collapses/expands the explorer. The chevron
           points at the panel while open (left) and back at the reopen
           button while collapsed (right). -->
      <Border Grid.Column="1" Grid.Row="0"
              Background="{ThemeResource EditorToggleStripBackgroundBrush}"
              BorderBrush="{ThemeResource ControlBorderBrush}"
              BorderThickness="0,0,1,0">
         <Button x:Name="LeftPanelToggle" Click="ToggleLeftPanel_Click"
                 VerticalAlignment="Center"
                 Background="Transparent" BorderThickness="0"
                 Padding="4,8"
                 ToolTipService.ToolTip="Collapse model explorer">
            <FontIcon x:Name="LeftToggleGlyph" Glyph="&#xE76C;" FontSize="12" />
         </Button>
      </Border>

      <local:ModelPanelControl x:Name="ModelPanel" Grid.Column="2" />

      <!-- Right panel: the diagnostics log only (backlog 042). The entity
           inspector moved out of the editor — double-clicking a table now
           opens the modeless EntityDetailsWindow (hosted by the app), and the
           editor just exposes the wiring for it. Declared first so its view
           model subscribes to the log before ModelPanelControl writes its
           startup message (backlog 014). -->
      <Grid x:Name="RightPanel" Grid.Column="4" Grid.Row="0" MinWidth="250">
         <local:DiagnosticsLogControl x:Name="DiagnosticsPanel" Margin="0"
            VerticalAlignment="Stretch"/>
      </Grid>

      <!-- Right toggle strip: collapses/expands the right panel so the
           drawing reflows into the freed space. It lives in its own column
           so the button stays reachable while the panel is collapsed. -->
      <Border Grid.Column="3" Grid.Row="0"
              Background="{ThemeResource EditorToggleStripBackgroundBrush}"
              BorderBrush="{ThemeResource ControlBorderBrush}"
              BorderThickness="1,0,0,0">
         <Button x:Name="RightPanelToggle" Click="ToggleRightPanel_Click"
                 VerticalAlignment="Center"
                 Background="Transparent" BorderThickness="0"
                 Padding="4,8"
                 ToolTipService.ToolTip="Collapse right panel">
            <FontIcon x:Name="ToggleGlyph" Glyph="&#xE76B;" FontSize="12" />
         </Button>
      </Border>
   </Grid>
</UserControl>
