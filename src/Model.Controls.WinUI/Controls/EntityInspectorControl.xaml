<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ModelConsole.Controls.EntityInspectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModelConsole.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

   <Grid x:Name="RootGrid" BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness=".5">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="{ThemeResource InspectorHeaderBackgroundBrush}"
              BorderBrush="{ThemeResource ControlBorderBrush}"
              BorderThickness="1" Padding="8,6">
         <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderText" Text="Entity details"
                       FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource ControlHeaderForegroundBrush}" />
            <Button x:Name="ModeButton" Grid.Column="1" Content="Edit"
                    MinWidth="0" Padding="10,3" FontSize="11"
                    Click="ModeButton_Click"
                    ToolTipService.ToolTip="Edit this entity (reveals the edit surface)" />
         </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
         <StackPanel x:Name="ContentPanel" Padding="8" Spacing="8" />
      </ScrollViewer>
   </Grid>
</UserControl>
