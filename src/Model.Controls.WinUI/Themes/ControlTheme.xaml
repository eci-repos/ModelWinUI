<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <!-- EDAM Studio control theme (backlog 035): named pastel brushes for the
        control headers, panel toggle strips, zoom toolbars, menu bar, and
        renderer bar. One file to change the whole chrome. The tints are
        deliberately outside the ERD table families (entity #DCE9F7,
        reference #E2EFDA) so the panels and the tables stay visually
        separable. Controls reference the keys via {ThemeResource}, so a host
        can shadow any key in its own merged dictionary and a future
        light/dark split drops into ThemeDictionaries without touching a
        control. -->

   <!-- Panel headers (left explorer + right diagnostics): the same soft
        neutral gray as the center zoom toolbar, so every banner in the
        editor reads as one chrome strip (backlog 042). The old per-panel
        pastels (lavender/peach/cream) were retired. -->
   <SolidColorBrush x:Key="ExplorerHeaderBackgroundBrush" Color="#F3F3F7" />
   <SolidColorBrush x:Key="InspectorHeaderBackgroundBrush" Color="#F3F3F7" />
   <SolidColorBrush x:Key="DiagnosticsHeaderBackgroundBrush" Color="#F3F3F7" />

   <!-- Editor toggle strips (left/right collapse): neutral, thin. -->
   <SolidColorBrush x:Key="EditorToggleStripBackgroundBrush" Color="#F1EFF7" />

   <!-- Zoom toolbars: soft neutral gray keeps the drawing area calm. -->
   <SolidColorBrush x:Key="ModelToolbarBackgroundBrush" Color="#F3F3F7" />
   <SolidColorBrush x:Key="SkiaToolbarBackgroundBrush" Color="#F3F3F7" />

   <!-- App chrome: top menu bar + renderer bar. The menu is a neutral gray
        (same relative darkness as the earlier lavender) so it reads as a
        bar; the window base matches the chrome so no white shows in the
        margins around it. -->
   <SolidColorBrush x:Key="MenuBarBackgroundBrush" Color="#DDDDDD" />
   <SolidColorBrush x:Key="MenuBarForegroundBrush" Color="#1F1F1F" />
   <SolidColorBrush x:Key="MenuBarBorderBrush" Color="#C6C6C6" />
   <SolidColorBrush x:Key="RendererBarBackgroundBrush" Color="#F0EEF4" />

   <!-- Window base + slim footer: soft neutral chrome base (so element
        margins blend instead of showing white) and the thin footer strip
        that separates the controls from the bottom of the window. -->
   <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0EEF4" />
   <SolidColorBrush x:Key="WindowFooterBackgroundBrush" Color="#F0EEF4" />

   <!-- Shared text and borders. -->
   <SolidColorBrush x:Key="ControlHeaderForegroundBrush" Color="#1F1F1F" />
   <SolidColorBrush x:Key="ControlBorderBrush" Color="#D9D9E3" />

   <!-- Entity details window (backlog 042): the alternating content band
        behind every other column row (and every other column edit sub-card)
        — the "gray" of the white/gray zebra, so the eye can follow one column
        down the list. A touch deeper than the chrome gray #F3F3F7 so it reads
        as a content band, not another header strip. -->
   <SolidColorBrush x:Key="InspectorAlternateBandBrush" Color="#EEEEF2" />
</ResourceDictionary>
